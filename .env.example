# Copy to .env, fill in, chmod 600.
# The Unraid template exposes these as masked fields instead.

# Required
OPENCLAW_GATEWAY_TOKEN=replace-with-openssl-rand-hex-32
OPENCODE_API_KEY=replace-with-opencode-zen-key
DISCORD_BOT_TOKEN=replace-with-new-discord-bot-token
DISCORD_OWNER_ID=your-discord-user-id
ASSISTANT_EMAIL=assistant.you@gmail.com
GMAIL_APP_PASSWORD=replace-with-google-app-password
ASSISTANT_CALENDAR_ID=abc123@group.calendar.google.com
GOG_KEYRING_PASSWORD=replace-with-a-local-keyring-password

# Optional
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
TZ=America/Toronto
OWNER_NAME=Your Name
ASSISTANT_NAME=Assistant
CITY=
WORK_HOURS=09:00-17:00
QUIET_HOURS=22:00-07:00
OBSIDIAN_SUBDIR=Assistant
MEMORY_LIMIT=1g

# Host paths for compose
OPENCLAW_APPDATA=/mnt/cache/appdata/openclaw-assistant
OBSIDIAN_HOST_PATH=/mnt/user/Obsidian/YourVault
GOOGLE_CREDENTIALS_DIR=/mnt/cache/appdata/openclaw-assistant/google
